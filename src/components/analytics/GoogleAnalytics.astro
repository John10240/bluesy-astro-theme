---
interface Props {
	analyticsId: string;
}

const { analyticsId } = Astro.props;
---

<!-- Google tag (gtag.js) -->
<script is:inline data-swup-ignore-script define:vars={{ analyticsId }}>window.dataLayer = window.dataLayer || [];

window.gtag = window.gtag || function gtag() {
    dataLayer.push(arguments);
};

(function() {
    let lastTrackedPath = window.location.pathname + window.location.search;
    let initialized = false;

    function loadGoogleAnalytics() {
        if (initialized) return;
        initialized = true;

        const script = document.createElement('script');
        script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
        script.async = true;
        script.dataset.swupIgnoreScript = '';
        script.addEventListener('load', () => {
            window.gtag('js', new Date());
            window.gtag('config', analyticsId, {
                page_path: window.location.pathname + window.location.search,
                page_title: document.title,
            });
        }, { once: true });
        document.head.appendChild(script);
    }

    function scheduleGoogleAnalytics() {
        const schedule = window.requestIdleCallback || ((callback) => setTimeout(callback, 1));
        schedule(loadGoogleAnalytics, { timeout: 5000 });
    }

    function trackPageView() {
        const currentPath = window.location.pathname + window.location.search;
        if (currentPath === lastTrackedPath || typeof window.gtag !== 'function') {
            return;
        }

        lastTrackedPath = currentPath;
        window.gtag('config', analyticsId, {
            page_path: currentPath,
            page_title: document.title,
        });
    }

    function setupSwupTracking() {
        if (!window.swup?.hooks) {
            return;
        }

        window.swup.hooks.on('page:view', trackPageView);
    }

    if (window.swup?.hooks) {
        setupSwupTracking();
    } else {
        document.addEventListener('swup:enable', setupSwupTracking, { once: true });
    }

    if (document.readyState === 'complete') {
        scheduleGoogleAnalytics();
    } else {
        window.addEventListener('load', scheduleGoogleAnalytics, { once: true });
    }
})();
</script>
